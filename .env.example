# tesseract path - only needed if tesseract isn't on PATH (installer didn't add it for me)
# windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# gemini api key for the vision stage - free at aistudio.google.com, no card needed
GEMINI_API_KEY=
# optional override, defaults to gemini-3.1-flash-lite (gemini-3.8-flash's free daily quota is way too low - 20/day)
GEMINI_MODEL=

# optional, uncomment to change (leave these commented out to use the defaults)
# free tier allows 15 requests/minute per model; the default 14 stays just under it. raise it with a paid key
# GEMINI_REQUESTS_PER_MINUTE=14
# how many keyframes are sent to gemini at the same time
# GEMINI_MAX_WORKERS=4
# delete audio.wav once transcript.json exists (default true). set false to keep the audio file
# DELETE_AUDIO_AFTER_TRANSCRIPT=true
